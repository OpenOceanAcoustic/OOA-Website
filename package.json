{
  "name": "@ooa/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "wasm:build": "bash scripts/wasm/build-all.sh",
    "wasm:sync": "bash scripts/wasm/build-all.sh && npm install && npm run verify:wasm && node scripts/wasm/refresh-dev-cache.mjs",
    "verify:wasm": "node scripts/wasm/verify-packages.mjs && node scripts/wasm/print-provenance.mjs",
    "verify:imports": "node scripts/verify/import-boundaries.mjs",
    "dev": "npm run dev --workspace @ooa/web",
    "build": "npm run verify:wasm && npm run verify:imports && npm run typecheck && npm run build --workspace @ooa/web",
    "verify:release": "node scripts/release/verify-static.mjs",
    "preview": "npm run preview --workspace @ooa/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/build/provenance.test.mjs tests/build/verify-sources.test.mjs tests/build/verify-wasm-packages.test.mjs",
    "test:build": "npm run build && node --test tests/build/spa-artifacts.test.mjs && npm run verify:release",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest",
    "storybook": "npm run storybook --workspace @ooa/ui-docs",
    "build-storybook": "npm run build-storybook --workspace @ooa/ui-docs"
  },
  "dependencies": {
    "@openocean/field-bellhop-2d": "file:.wasm-packages/active/field-bellhop-2d",
    "@openocean/field-normal-mode-kraken": "file:.wasm-packages/active/field-normal-mode-kraken",
    "@openocean/field-pe-ram": "file:.wasm-packages/active/field-pe-ram",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "storybook": "10.5.10",
    "typescript": "5.9.3",
    "vite": "7.1.3",
    "vitest": "4.1.11"
  },
  "engines": { "node": ">=22.13.0" }
}
